{
  "info": {
    "_postman_id": "a9c7b12d-98e3-4721-a3fc-archivevault01",
    "name": "ArchiveVault API Collection",
    "description": "Comprehensive test suite for ArchiveVault: A GDPR/CCPA data lifecycle and erasure engine featuring 3-phase sagas (quarantine -> pivot -> purge), envelope crypto-shredding, zero-PII hash-chained ledger, suppression restore-replay, and coverage drift monitoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "tenant_id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "subject_id",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string"
    },
    {
      "key": "data_map_version_id",
      "value": "33333333-3333-3333-3333-333333333333",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "44444444-4444-4444-4444-444444444444",
      "type": "string"
    },
    {
      "key": "hold_id",
      "value": "55555555-5555-5555-5555-555555555555",
      "type": "string"
    },
    {
      "key": "finding_id",
      "value": "66666666-6666-6666-6666-666666666666",
      "type": "string"
    }
